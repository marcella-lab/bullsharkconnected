PORT=8787
APP_URL=http://localhost:5173

# Account invitation and password-reset emails (server-side Resend integration).
# EMAIL_FROM must be a sender address verified in your Resend account.
RESEND_API_KEY=
EMAIL_FROM="BullShark Connected <invites@your-domain.com>"

# Set these to a persistent Railway volume in production.
DATA_PATH=/data/portal.json
CONTRACT_STORAGE_DIR=/data/contracts

# demo creates local envelopes; docusign sends real envelopes.
ESIGN_PROVIDER=demo
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi
DOCUSIGN_OAUTH_BASE_PATH=account-d.docusign.com
# Either paste a PEM key with escaped newlines or point at a PEM file.
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_PRIVATE_KEY_PATH=
